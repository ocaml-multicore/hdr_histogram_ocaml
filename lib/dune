(library
 (name hdr_histogram)
 (public_name hdr_histogram)
 (install_c_headers hdr_histogram)
 (foreign_archives hdr_histogram)
 ; ctypes backward compatibility shims warn sometimes; suppress them
 (flags
  (:standard -w -9-27))
 (libraries unix)
 (ctypes
  (external_library_name hdr_histogram)
  (build_flags_resolver
   (vendored
    (c_flags :standard "-I.")))
  (headers
   (preamble
    "#include <hdr_histogram.h>\n     #include <stdio.h>\n\n     static inline bool hdr_record_value_int(struct hdr_histogram* h, int value)\n     { return hdr_record_value(h, value); }\n    "))
  (type_description
   (instance Type)
   (functor Type_description))
  (function_description
   (concurrency sequential)
   (instance Function_fast)
   (functor Function_description_fast))
  (function_description
   (concurrency unlocked)
   (errno_policy return_errno)
   (instance Stdio)
   (functor Stdio_description))
  (function_description
   (concurrency unlocked)
   (instance Function)
   (functor Function_description))
  (generated_types Types_generated)
  (generated_entry_point C)))

(data_only_dirs libhdr_histogram)

(rule
 (enabled_if
  (= %{os_type} "Unix"))
 (deps
  (source_tree libhdr_histogram))
 (targets dllhdr_histogram.so libhdr_histogram.a hdr_histogram.h)
 (action
  (no-infer
   (progn
    (chdir
     libhdr_histogram
     (progn
      (run cmake -E make_directory _build)
      (chdir
       _build
       (progn
        (run cmake .. -DHDR_HISTOGRAM_BUILD_PROGRAMS=OFF)
        (run cmake --build . --config Release)))))
    (copy
     libhdr_histogram/_build/src/libhdr_histogram_static.a
     libhdr_histogram.a)
    (copy
     libhdr_histogram/_build/src/libhdr_histogram.so
     dllhdr_histogram.so)
    (copy libhdr_histogram/include/hdr/hdr_histogram.h hdr_histogram.h)))))

; On Windows, compile the C library directly instead of using cmake.
; Cygwin cmake generates /cygdrive/ paths that the mingw cc cannot resolve.

(rule
 (enabled_if
  (= %{os_type} "Win32"))
 (deps
  (source_tree libhdr_histogram))
 (targets dllhdr_histogram.dll libhdr_histogram.a hdr_histogram.h)
 (action
  (no-infer
   (progn
    (run
     %{cc}
     -c
     -O2
     -std=c99
     -Ilibhdr_histogram/include
     -Ilibhdr_histogram/src
     libhdr_histogram/src/hdr_encoding.c
     libhdr_histogram/src/hdr_histogram.c
     libhdr_histogram/src/hdr_histogram_log_no_op.c
     libhdr_histogram/src/hdr_interval_recorder.c
     libhdr_histogram/src/hdr_thread.c
     libhdr_histogram/src/hdr_time.c
     libhdr_histogram/src/hdr_writer_reader_phaser.c)
    (run
     ar
     rcs
     libhdr_histogram.a
     hdr_encoding.o
     hdr_histogram.o
     hdr_histogram_log_no_op.o
     hdr_interval_recorder.o
     hdr_thread.o
     hdr_time.o
     hdr_writer_reader_phaser.o)
    (run
     %{cc}
     -shared
     -o
     dllhdr_histogram.dll
     -Wl,--export-all-symbols
     hdr_encoding.o
     hdr_histogram.o
     hdr_histogram_log_no_op.o
     hdr_interval_recorder.o
     hdr_thread.o
     hdr_time.o
     hdr_writer_reader_phaser.o
     -lws2_32)
    (copy libhdr_histogram/include/hdr/hdr_histogram.h hdr_histogram.h)))))
